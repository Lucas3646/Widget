<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/macroRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingHorizontal="8dp"
    android:paddingVertical="9dp"
    android:background="@drawable/widget_background">

    <TextView
        android:id="@+id/macroTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="MACRO"
        android:textColor="#38F27A"
        android:textSize="9sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/macroEvent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="CPI"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/macroCountdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:text="J-2 · 14:30"
        android:textColor="#CDD8E4"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/macroForecast"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Att. 2,8%"
        android:textColor="#8EA0B2"
        android:textSize="9sp" />

    <TextView
        android:id="@+id/macroActual"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:text="Rés. —"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/macroPrevious"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:text="Préc. —"
        android:textColor="#708396"
        android:textSize="8sp" />
</LinearLayout>
