<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_background">

    <TextView
        android:id="@+id/dividendTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DIVIDENDES · IBKR"
        android:textColor="#38F27A"
        android:textStyle="bold"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/dividendSymbol"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="IBKR"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/dividendAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Connexion requise"
        android:textColor="#8EA0B2"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/dividendDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Ouvre Market Widgets"
        android:textColor="#FFFFFF"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/dividendDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text=""
        android:textColor="#8EA0B2"
        android:textSize="11sp"
        android:maxLines="2" />
</LinearLayout>
