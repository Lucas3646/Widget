<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="11dp"
    android:background="@drawable/widget_background">

    <TextView
        android:id="@+id/dividendTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="DIVIDENDES · IBKR"
        android:textColor="#38F27A"
        android:textStyle="bold"
        android:textSize="9sp"
        android:maxLines="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/dividendSymbol"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="—"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="19sp"
            android:maxLines="1" />

        <TextView
            android:id="@+id/dividendCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="J—"
            android:textColor="#38F27A"
            android:textStyle="bold"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/dividendAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="— €"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="14sp"
        android:maxLines="1" />

    <TextView
        android:id="@+id/dividendDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="Prochain : —"
        android:textColor="#8EA0B2"
        android:textSize="9sp"
        android:maxLines="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="REÇU YTD" android:textColor="#8EA0B2" android:textStyle="bold" android:textSize="7sp" />
            <TextView android:id="@+id/dividendReceivedYtd" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="— €" android:textColor="#38F27A" android:textStyle="bold" android:textSize="11sp" android:maxLines="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="RESTANT" android:textColor="#8EA0B2" android:textStyle="bold" android:textSize="7sp" />
            <TextView android:id="@+id/dividendRemaining" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="— €" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="11sp" android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/dividendDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text=""
        android:textColor="#8EA0B2"
        android:textSize="7sp"
        android:maxLines="2" />
</LinearLayout>
