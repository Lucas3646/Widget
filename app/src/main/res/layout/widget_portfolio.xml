<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_background">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PATRIMOINE"
        android:textColor="#38F27A"
        android:textStyle="bold"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/portfolioTotal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="— €"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="28sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="IBKR + Kraken"
        android:textColor="#38F27A"
        android:textStyle="bold"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/portfolioIbkr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="IBKR · à connecter"
        android:textColor="#FFFFFF"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/portfolioKraken"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Kraken · à connecter"
        android:textColor="#8EA0B2"
        android:textSize="13sp" />
</LinearLayout>
