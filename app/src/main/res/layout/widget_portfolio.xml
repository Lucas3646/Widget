<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_background">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="PORTFOLIO TRACKER" android:textColor="#38F27A" android:textStyle="bold" android:textSize="11sp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:id="@+id/portfolioTotal" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="— €" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="25sp" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end">
            <TextView android:id="@+id/portfolioDayChange" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="— €" android:textColor="#8EA0B2" android:textStyle="bold" android:textSize="12sp" />
            <TextView android:id="@+id/portfolioDayPercent" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="— % aujourd’hui" android:textColor="#8EA0B2" android:textStyle="bold" android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TOP 3" android:textColor="#38F27A" android:textStyle="bold" android:textSize="10sp" />
            <TextView android:id="@+id/portfolioTop1" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textColor="#FFFFFF" android:textSize="11sp" />
            <TextView android:id="@+id/portfolioTop2" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textColor="#FFFFFF" android:textSize="11sp" />
            <TextView android:id="@+id/portfolioTop3" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textColor="#FFFFFF" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FLOP 3" android:textColor="#FF6B6B" android:textStyle="bold" android:textSize="10sp" />
            <TextView android:id="@+id/portfolioFlop1" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textColor="#FFFFFF" android:textSize="11sp" />
            <TextView android:id="@+id/portfolioFlop2" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textColor="#FFFFFF" android:textSize="11sp" />
            <TextView android:id="@+id/portfolioFlop3" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textColor="#FFFFFF" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/portfolioIbkr" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="7dp" android:text="IBKR · à connecter" android:textColor="#8EA0B2" android:textSize="10sp" />
    <TextView android:id="@+id/portfolioKraken" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Kraken · à connecter" android:textColor="#8EA0B2" android:textSize="10sp" />
</LinearLayout>
